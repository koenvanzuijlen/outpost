{
  "go.lintTool": "golangci-lint-v2",
  "go.lintOnSave": "package",
  "go.lintFlags": ["--path-mode=abs"],
  "go.alternateTools": {
    "golangci-lint-v2": "${workspaceFolder}/.tools/golangci-lint-v2"
  },
  "go.toolsManagement.checkForUpdates": "off",
  "gopls": {
    "ui.diagnostic.staticcheck": true
  }
}
