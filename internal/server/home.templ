package server

// homeView renders the home page: all playing games, and samples of the backlog and the wishlist. The backlog and the
// wishlist each have a link to the full list with the total number of games.
templ homeView(page homePage) {
	@layout("") {
		<h1>Outpost</h1>
		<section class="page-section">
			<h2>Playing</h2>
			if len(page.PlayingGames) > 0 {
				<ul class="game-grid">
					for _, entry := range page.PlayingGames {
						<li>
							@libraryCard(entry)
						</li>
					}
				</ul>
			} else {
				<p>You are not currently playing any games.</p>
			}
		</section>
		<section class="page-section">
			<h2>Backlog</h2>
			if len(page.BacklogGames) > 0 {
				<ul class="game-grid">
					for _, entry := range page.BacklogGames {
						<li>
							@libraryCard(entry)
						</li>
					}
				</ul>
			} else {
				<p>Your backlog is empty.</p>
			}
			<a href="/library?status=backlog" class="page-section__more">View all <span class="visually-hidden">backlog games</span> ({ page.BacklogCount })</a>
		</section>
		<section class="page-section">
			<h2>Wishlist</h2>
			if len(page.WishlistGames) > 0 {
				<ul class="game-grid">
					for _, entry := range page.WishlistGames {
						<li>
							@gameCard(entry.Game, "", 0)
						</li>
					}
				</ul>
			} else {
				<p>Your wishlist is empty.</p>
			}
			<a href="/wishlist" class="page-section__more">View all <span class="visually-hidden">wishlist games</span> ({ page.WishlistCount })</a>
		</section>
	}
}
