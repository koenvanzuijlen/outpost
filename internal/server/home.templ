package server

// homeView renders the home page: the playing games, and samples of the backlog and the wishlist, each with a link to
// the full list.
templ homeView(page homePage) {
	@layout("") {
		<h1>Outpost</h1>
		<section class="home-section">
			<h2>Playing</h2>
			if len(page.PlayingGames) > 0 {
				<ul class="game-grid">
					for _, entry := range page.PlayingGames {
						<li>
							@libraryCard(entry)
						</li>
					}
				</ul>
			} else {
				<p>You are not currently playing any games.</p>
			}
			<a href="/library?status=playing&sort=started">Show all</a>
		</section>
		<section class="home-section">
			<h2>Backlog ({ page.BacklogCount })</h2>
			if len(page.BacklogGames) > 0 {
				<ul class="game-grid">
					for _, entry := range page.BacklogGames {
						<li>
							@libraryCard(entry)
						</li>
					}
				</ul>
			} else {
				<p>Your backlog is empty.</p>
			}
			<a href="/library?status=backlog">Show all</a>
		</section>
		<section class="home-section">
			<h2>Wishlist ({ page.WishlistCount })</h2>
			if len(page.WishlistGames) > 0 {
				<ul class="game-grid">
					for _, entry := range page.WishlistGames {
						<li>
							@gameCard(entry.Game, "", 0)
						</li>
					}
				</ul>
			} else {
				<p>Your wishlist is empty.</p>
			}
			<a href="/wishlist">Show all</a>
		</section>
	}
}
