package server

import "github.com/koenvanzuijlen/outpost/internal/database"

// gameStatusBadge shows status as a badge in the color of the status. The full variant shows the icon and the status
// text. The compact variant shows only the icon, with the status text as its accessible label and tooltip.
templ gameStatusBadge(status database.GameStatus, compact bool) {
	{{
		statusIcon := gameStatusIcon(status)
		statusLabel := gameStatusLabel(status)
	}}
	<span
		class={ "badge", "badge--" + string(status) }
		if compact {
			role="img"
			aria-label={ statusLabel }
			title={ statusLabel }
		}
	>
		if statusIcon != "" {
			@icon(statusIcon)
		}
		if !compact {
			{ statusLabel }
		}
	</span>
}

// gameStatusPicker shows one status button per status in statuses, as radio inputs named status. The button of current
// is checked. Each button looks like a status badge, and an unchecked button is grey.
templ gameStatusPicker(statuses []database.GameStatus, current database.GameStatus) {
	<fieldset class="status-picker">
		<legend class="status-picker__legend">Status</legend>
		for _, status := range statuses {
			<label class="status-picker__option">
				<input class="visually-hidden" type="radio" name="status" value={ string(status) } checked?={ status == current }/>
				@gameStatusBadge(status, false)
			</label>
		}
	</fieldset>
}
