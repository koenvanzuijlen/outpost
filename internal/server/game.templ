package server

import (
	"github.com/koenvanzuijlen/outpost/internal/database"
	"github.com/koenvanzuijlen/outpost/internal/database/dbgen"
	"strconv"
	"time"
)

// gameView renders the game page as a header and sections, in this order: the IGDB details, the DLC (only for a base
// game), your library, your copies and your playthroughs. The library and playthrough sections show only for a game in
// the library that is not wishlisted.
templ gameView(page gamePage) {
	{{ inLibrary := page.Details.UserGame != nil && !page.Details.UserGame.Wishlisted }}
	@layout("") {
		@gameInfo(page)
		if page.Details.Parent == nil && (page.Details.Game.DlcsFetchedAt == nil || len(page.Details.DLCs) > 0) {
			@gameDLC(page)
		}
		if inLibrary {
			@gameLibrary(page)
		}
		@gameCopies(page)
		if inLibrary {
			@gamePlaythroughs(page)
		}
	}
}

// gameInfo is the page header with the IGDB details: the cover on the left, and the title, the parent game of a DLC,
// the release year, the summary and the release platforms on the right. A game without a cover shows a placeholder
// icon.
templ gameInfo(page gamePage) {
	<header class="game-info">
		<div class="game-info__cover">
			if page.Details.Game.CoverUrl != nil {
				<img src={ *page.Details.Game.CoverUrl } alt="" width="264" height="374"/>
			} else {
				@icon("image-off")
			}
		</div>
		<div class="game-info__text">
			<h1 class="game-info__title">{ page.Details.Game.Title }</h1>
			if page.Details.Parent != nil {
				<p>DLC of <a href={ gameURL(page.Details.Parent.IgdbID) }>{ page.Details.Parent.Title }</a></p>
			}
			if page.Details.Game.ReleasedAt != nil {
				<p class="game-info__year">
					<time datetime={ page.Details.Game.ReleasedAt.Format("2006-01-02") }>{ page.Details.Game.ReleasedAt.Year() }</time>
				</p>
			}
			if page.Details.Game.Summary != nil {
				<p class="game-info__summary">{ *page.Details.Game.Summary }</p>
			}
			if len(page.Details.Platforms) > 0 {
				<p class="game-info__platforms">
					Released on: { platformNames(page.Details.Platforms) }
				</p>
			}
		</div>
	</header>
}

// gameLibraryState shows the forms that add the game to the library or the wishlist, in one row. A wishlisted game shows
// only the library form, and a DLC shows a library form without a platform when its base game is in the library. It
// shows nothing if the game is already in the library.
templ gameLibraryState(page gamePage) {
	{{ url := gameURL(page.Details.Game.IgdbID) }}
	if page.CanAddToLibrary {
		<div class="add-forms">
			<form class="add-form" method="post" action={ url + "/library" }>
				<label class="add-form__field">
					Owned on
					<select class="add-form__input" name="platform_id">
						for _, platform := range page.Details.Platforms {
							<option value={ strconv.Itoa(int(platform.IgdbID)) }>{ platform.Name }</option>
						}
						<option value="">Not owned</option>
					</select>
				</label>
				<button class="add-form__submit" type="submit">Add to library</button>
			</form>
			if page.CanAddToWishlist {
				<form class="add-form" method="post" action={ url + "/wishlist" }>
					<button class="add-form__submit" type="submit">Add to wishlist</button>
				</form>
			}
		</div>
	} else if page.CanAddDLC {
		<form class="add-form" method="post" action={ url + "/library" }>
			<button class="add-form__submit" type="submit">Add to library</button>
		</form>
	}
}

// gameCopies is the section about ownership. For a library game, it shows one expandable row per copy, titled with
// the owned DLC count. An open row shows an owned toggle per DLC available on that platform, and a form to remove the
// copy. Below the rows is a form to add a copy. For a DLC, it shows the base game copies that own the DLC as rows that
// do not expand, and points to the page of the base game, where ownership is managed. A game outside the library states
// that, and shows the forms to add it. A wishlisted game states that it is on the wishlist, and shows the form to add it
// to the library and the form to remove it from the wishlist.
templ gameCopies(page gamePage) {
	{{ wishlisted := page.Details.UserGame != nil && page.Details.UserGame.Wishlisted }}
	<section class="page-section">
		<h2>Your copies</h2>
		if wishlisted {
			<p>On your wishlist.</p>
		} else if page.Details.UserGame == nil && page.Details.Parent == nil {
			<p>Not in your library.</p>
		}
		if page.Details.UserGame != nil || page.Details.Parent != nil {
			{{ url := gameURL(page.Details.Game.IgdbID) }}
			if len(page.Details.OwnedPlatforms) > 0 {
				<ul class="game-copies">
					for _, platform := range page.Details.OwnedPlatforms {
						<li>
							if page.Details.Parent == nil {
								<details class="game-copy">
									<summary class="game-copy__header">
										<span class="game-copy__title">
											{ copySummary(platform.Name, page.Details.CopyDLCs[platform.IgdbID]) }
										</span>
										@icon("chevron-down")
									</summary>
									if len(page.Details.CopyDLCs[platform.IgdbID]) > 0 {
										<ul class="game-copy__dlcs">
											for _, dlc := range page.Details.CopyDLCs[platform.IgdbID] {
												<li>
													<form
														method="post"
														action={ gameURL(page.Details.Game.IgdbID) + "/copies/" + strconv.Itoa(int(platform.IgdbID)) + "/dlcs/" + strconv.Itoa(int(dlc.Game.IgdbID)) }
													>
														<button type="submit" name="owned" value={ !dlc.Owned } aria-pressed={ dlc.Owned } class="game-copy__toggle">
															if dlc.Owned {
																@icon("square-check-big")
															} else {
																@icon("square")
															}
															{ dlcTitle(page.Details.Game.Title, dlc.Game.Title) }
															if dlc.Game.ReleasedAt != nil {
																<span class="game-copy__year">{ dlc.Game.ReleasedAt.Year() }</span>
															}
														</button>
													</form>
												</li>
											}
										</ul>
									}
									<details class="game-copy__remove">
										<summary>Remove copy</summary>
										<form method="post" action={ url + "/copies/" + strconv.Itoa(int(platform.IgdbID)) + "/remove" }>
											<p>This also removes the DLC you marked as owned on this copy.</p>
											<button type="submit">Really remove</button>
										</form>
									</details>
								</details>
							} else {
								<div class="game-copy">
									<div class="game-copy__header">
										<span class="game-copy__title">
											{ platform.Name }
										</span>
									</div>
								</div>
							}
						</li>
					}
				</ul>
			} else if page.Details.Parent == nil && !wishlisted {
				<p>Not owned on any platform.</p>
			}
			if page.Details.Parent != nil {
				<p>
					if len(page.Details.OwnedPlatforms) == 0 {
						Not owned on any platform.
					}
					Ownership of this DLC is managed on the page of <a href={ gameURL(page.Details.Parent.IgdbID) }>{ page.Details.Parent.Title }</a>.
				</p>
			}
			if page.Details.Parent == nil && !wishlisted && len(page.CopyPlatformOptions) > 0 {
				<h3>Add a copy</h3>
				<form class="add-form" method="post" action={ url + "/copies" }>
					<label class="add-form__field">
						Owned on
						<select class="add-form__input" name="platform_id">
							for _, platform := range page.CopyPlatformOptions {
								<option value={ strconv.Itoa(int(platform.IgdbID)) }>{ platform.Name }</option>
							}
						</select>
					</label>
					<button class="add-form__submit" type="submit">Add copy</button>
				</form>
			}
		}
		@gameLibraryState(page)
		if wishlisted {
			@gameRemove(page)
		}
	</section>
}

// gameDLC is the section with all DLC of a base game, newest first, as small game cards with their status. The card
// titles leave out the title of the base game. If the DLC was never fetched, it shows a message instead.
templ gameDLC(page gamePage) {
	<section class="page-section">
		<h2>DLC</h2>
		if page.Details.Game.DlcsFetchedAt != nil {
			<ul class="game-grid game-grid--small">
				for _, dlc := range page.Details.DLCs {
					<li>
						{{
							card := dlc.Game
							card.Title = dlcTitle(page.Details.Game.Title, dlc.Game.Title)
						}}
						@gameCard(card, database.GameStatus(derefOrZero(dlc.Status)), 0)
					</li>
				}
			</ul>
		} else {
			<p>DLC couldn't be loaded.</p>
		}
	</section>
}

// gameLibrary is the section of a library game with the form to change the status, the rating and the notes, and the
// form to remove the game from the library. The form is prefilled with the current values. With JavaScript, the form
// saves each change right away (data-auto-save); without it, the Save button submits the form.
templ gameLibrary(page gamePage) {
	<section class="page-section">
		<h2>Your library</h2>
		<form class="game-details" method="post" action={ gameURL(page.Details.Game.IgdbID) + "/details" } data-auto-save>
			@gameStatusPicker(page.Statuses, page.CurrentStatus)
			@ratingInput(page.CurrentRating)
			<label class="game-details__notes">
				Notes
				<textarea class="game-details__notes-input" name="notes" maxlength={ page.MaxNotesLength }>{ derefOrZero(page.Details.UserGame.Notes) }</textarea>
			</label>
			<noscript>
				<button class="game-details__save" type="submit">Save</button>
			</noscript>
			<p class="game-details__save-status" role="status" data-save-status></p>
		</form>
		@gameRemove(page)
	</section>
}

// gamePlaythroughDate shows a playthrough date as a time element, for example "20 November 2026", with the date in
// ISO 8601 format as its machine-readable value.
templ gamePlaythroughDate(date time.Time) {
	<time datetime={ date.Format("2006-01-02") }>{ date.Format("2 January 2006") }</time>
}

// gamePlaythroughs is the section with the playthroughs of the game, as a list of cards. A form below the list starts
// a new playthrough.
templ gamePlaythroughs(page gamePage) {
	<section class="page-section" id="playthroughs">
		<h2>Your playthroughs</h2>
		if len(page.Details.Playthroughs) > 0 {
			<ul class="game-playthroughs">
				for _, entry := range page.Details.Playthroughs {
					<li class="game-playthrough" id={ playthroughAnchor(entry.Playthrough.ID) }>
						@gamePlaythrough(page, entry)
					</li>
				}
			</ul>
		} else {
			<p>No playthroughs yet.</p>
		}
		<h3>Start a playthrough</h3>
		<form class="game-playthrough-form" method="post" action={ gameURL(page.Details.Game.IgdbID) + "/playthroughs" }>
			<label class="game-playthrough-form__field">
				Name
				<input class="game-playthrough-form__input" type="text" name="name"/>
			</label>
			<label class="game-playthrough-form__field">
				Platform
				<select class="game-playthrough-form__input" name="platform">
					<option value="">No platform</option>
					for _, platform := range page.Details.OwnedPlatforms {
						<option value={ strconv.Itoa(int(platform.IgdbID)) }>{ platform.Name }</option>
					}
				</select>
			</label>
			<button class="game-playthrough-form__submit" type="submit">Start</button>
		</form>
	</section>
}

// gamePlaythrough is the card of one playthrough. The card shows the name as its title if the playthrough has one, a
// line with the platform and the dates, and one button per outcome that looks like a status badge. The button of the
// current outcome is pressed. A pencil opens the edit form in place of the card content. The form to delete the
// playthrough is inside the edit form. The finished date is only in the edit form if the playthrough is not in
// progress.
templ gamePlaythrough(page gamePage, entry dbgen.ListPlaythroughsForUserGameIDRow) {
	{{ url := gameURL(page.Details.Game.IgdbID) + "/playthroughs/" + strconv.FormatInt(entry.Playthrough.ID, 10) }}
	if entry.Playthrough.Name != nil {
		<h3 class="game-playthrough__title">
			{ *entry.Playthrough.Name }
		</h3>
	}
	if entry.PlatformName != nil || entry.Playthrough.StartedAt != nil || entry.Playthrough.FinishedAt != nil {
		<p class="game-playthrough__meta">
			if entry.PlatformName != nil {
				<span>{ *entry.PlatformName }</span>
			}
			if entry.Playthrough.StartedAt != nil {
				<span>Started @gamePlaythroughDate(*entry.Playthrough.StartedAt)</span>
			}
			if entry.Playthrough.FinishedAt != nil {
				<span>Finished @gamePlaythroughDate(*entry.Playthrough.FinishedAt)</span>
			}
		</p>
	}
	<form method="post" action={ url + "/outcome" }>
		<fieldset class="game-playthrough__outcomes">
			<legend class="visually-hidden">Outcome</legend>
			for _, option := range page.OutcomeOptions {
				<button
					class="game-playthrough__outcome"
					type="submit"
					name="outcome"
					value={ option.Value }
					aria-pressed={ option.Value == entry.Playthrough.Outcome }
				>
					@gameStatusBadgeWithLabel(database.GameStatus(option.Value), option.Label, false)
				</button>
			}
		</fieldset>
	</form>
	<details class="game-playthrough__edit">
		<summary class="game-playthrough__edit-toggle">
			@icon("pencil")
			@icon("x")
			<span class="visually-hidden">Edit playthrough</span>
		</summary>
		<form class="game-playthrough-form" method="post" action={ url }>
			<label class="game-playthrough-form__field">
				Name
				<input class="game-playthrough-form__input" type="text" name="name" value={ derefOrZero(entry.Playthrough.Name) }/>
			</label>
			<label class="game-playthrough-form__field">
				Platform
				<select class="game-playthrough-form__input" name="platform">
					<option value="" selected?={ derefOrZero(entry.Playthrough.PlatformID) == 0 }>No platform</option>
					for _, platform := range playthroughPlatformOptions(page.Details.OwnedPlatforms, entry) {
						<option value={ strconv.FormatInt(platform.IgdbID, 10) } selected?={ platform.ID == derefOrZero(entry.Playthrough.PlatformID) }>{ platform.Name }</option>
					}
				</select>
			</label>
			<label class="game-playthrough-form__field">
				Started
				<input
					class="game-playthrough-form__input"
					type="date"
					name="started_at"
					value={ dateInputValue(entry.Playthrough.StartedAt) }
				/>
			</label>
			if entry.Playthrough.Outcome != string(database.PlaythroughOutcomePlaying) {
				<label class="game-playthrough-form__field">
					Finished
					<input
						class="game-playthrough-form__input"
						type="date"
						name="finished_at"
						value={ dateInputValue(entry.Playthrough.FinishedAt) }
					/>
				</label>
			}
			<button class="game-playthrough-form__submit" type="submit">Save</button>
		</form>
		<details class="game-playthrough__delete">
			<summary>Delete playthrough</summary>
			<form method="post" action={ url + "/delete" }>
				<button type="submit">Really delete</button>
			</form>
		</details>
	</details>
}

// gameRemove is the form to remove the game from the library, or from the wishlist if the game is wishlisted. It
// states what the removal deletes.
templ gameRemove(page gamePage) {
	{{
		removeFrom := "library"
		if page.Details.UserGame.Wishlisted {
			removeFrom = "wishlist"
		}
	}}
	<details class="game-remove">
		<summary>
			Remove from { removeFrom }
		</summary>
		<form
			method="post"
			action={ gameURL(page.Details.Game.IgdbID) + "/" + removeFrom + "/remove" }
		>
			if !page.Details.UserGame.Wishlisted {
				if page.Details.Parent != nil {
					<p>Removes its status, rating and playthroughs. Ownership, managed on the base game's page, is kept.</p>
				} else {
					<p>Removes its copies, DLC ownership, playthroughs, and its DLC in the library.</p>
				}
			}
			<button type="submit">Really remove</button>
		</form>
	</details>
}
