package server

// layout is the HTML document around every page, with the menu bar. The search box in the menu bar is prefilled with
// query. The page content goes in children.
templ layout(query string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Outpost</title>
			<link rel="icon" type="image/svg+xml" href="/static/images/favicon.svg"/>
			<link rel="apple-touch-icon" href="/static/images/apple-touch-icon.png"/>
			<link rel="preload" href="/static/fonts/DMSans-Variable.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/css/outpost.css"/>
		</head>
		<body>
			@menuBar(query)
			<main class="page">
				{ children... }
			</main>
		</body>
	</html>
}
