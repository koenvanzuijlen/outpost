package server

import "strconv"

// searchForm is the game search box, prefilled with query.
templ searchForm(query string) {
	<form action="/search" role="search" class="search-form">
		<input type="search" name="q" value={ query } placeholder="Find games…" aria-label="Find games" class="search-form__input"/>
		<button type="submit" aria-label="Search" class="search-form__button">
			@icon("search")
		</button>
	</form>
}

// searchView renders the search page: a heading, then a hint, the results, "no results", or an error, depending on
// page.State. The results are an ordered list in the order of IGDB. Each result shows the cover, the title with a link
// to the game page, the year, the summary, and the forms to add the game to the library or the wishlist. The search box
// in the menu bar shows page.Query.
templ searchView(page searchPage) {
	@layout(page.Query) {
		<h1>Search</h1>
		switch page.State {
			case searchStateInitial:
				<p>Enter a search query to find games.</p>
			case searchStateNoResults:
				<p>No results found.</p>
			case searchStateResults:
				<ol class="search-results">
					for _, game := range page.Results {
						{{
							url := gameURL(int64(game.ID))
							cover := game.CoverURL()
						}}
						<li class="search-result">
							<div class="search-result__cover">
								if cover != "" {
									<img src={ cover } alt="" width="264" height="374"/>
								} else {
									@icon("image-off")
								}
							</div>
							<div class="search-result__text">
								<h2 class="search-result__title">
									<a href={ url }>{ game.Name }</a>
								</h2>
								if game.ReleaseYear() != 0 {
									<p class="search-result__year">{ game.ReleaseYear() }</p>
								}
								if game.Summary != "" {
									<p class="search-result__summary">{ game.Summary }</p>
								}
								<div class="add-forms search-result__actions">
									<form class="add-form" method="post" action={ url + "/library" }>
										<label class="add-form__field">
											Owned on
											<select class="add-form__input" name="platform_id">
												for _, platform := range game.Platforms {
													<option value={ strconv.Itoa(platform.ID) }>{ platform.Name }</option>
												}
												<option value="">Not owned</option>
											</select>
										</label>
										<button class="add-form__submit" type="submit">Add to library</button>
									</form>
									<form class="add-form" method="post" action={ url + "/wishlist" }>
										<button class="add-form__submit" type="submit">Add to wishlist</button>
									</form>
								</div>
							</div>
						</li>
					}
				</ol>
			case searchStateError:
				<p>{ page.Error }</p>
		}
	}
}
