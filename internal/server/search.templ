package server

import "strconv"

// searchForm is the game search box, prefilled with query.
templ searchForm(query string) {
	<form action="/search" role="search" class="search-form">
		<input type="search" name="q" value={ query } placeholder="Find games…" aria-label="Find games" class="search-form__input"/>
		<button type="submit" aria-label="Search" class="search-form__button">
			@icon("search")
		</button>
	</form>
}

// searchView renders the search page: a hint, the results with their add forms, "no results", or an error, depending on
// page.State. The search box in the menu bar shows page.Query.
templ searchView(page searchPage) {
	@layout(page.Query) {
		switch page.State {
			case searchStateInitial:
				<div>
					<p>Enter a search query to find games.</p>
				</div>
			case searchStateNoResults:
				<div>
					<p>No results found.</p>
				</div>
			case searchStateResults:
				<div>
					for _, game := range page.Results {
						{{ url := gameURL(int64(game.ID)) }}
						<div>
							if game.CoverURL() != "" {
								<img src={ game.CoverURL() } alt={ game.Name }/>
							}
							<p>
								<a href={ url }>{ game.Name }</a>
								if game.ReleaseYear() != 0 {
									({ game.ReleaseYear() })
								}
							</p>
							<form method="post" action={ url + "/library" }>
								<label>
									Owned on:
									<select name="platform_id">
										for _, platform := range game.Platforms {
											<option value={ strconv.Itoa(platform.ID) }>{ platform.Name }</option>
										}
										<option value="">Not owned</option>
									</select>
								</label>
								<button type="submit">Add to library</button>
							</form>
							<form method="post" action={ url + "/wishlist" }>
								<button type="submit">Add to wishlist</button>
							</form>
						</div>
					}
				</div>
			case searchStateError:
				<div>
					<p>{ page.Error }</p>
				</div>
		}
	}
}
