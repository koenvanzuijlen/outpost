package server

// libraryView renders the library page: a toggle link for each status, the sort form, and the matching games. In
// select mode, the games are checkboxes in the mass edit form, with a status picker, Apply and Cancel in a bar at the
// bottom of the window.
templ libraryView(page libraryPage) {
	@layout("") {
		<h1>Library</h1>
		<a href="/">Back to home</a>
		<div class="list-controls">
			<ul class="status-filter">
				for _, toggle := range page.StatusToggles {
					<li>
						<a
							href={ toggle.Href }
							class={ "status-filter__toggle",templ.KV("status-filter__toggle--inactive", !toggle.Active && len(page.Statuses) > 0) }
							if toggle.Active {
								aria-current="true"
							}
						>
							@gameStatusBadge(toggle.Status, false)
						</a>
					</li>
				}
			</ul>
			<form class="sort-form" method="get" action="/library">
				if page.Selecting {
					<input type="hidden" name="select" value="true"/>
				}
				for _, status := range page.Statuses {
					<input type="hidden" name="status" value={ string(status) }/>
				}
				<label class="sort-form__field">
					Sort by
					<select class="sort-form__select" name="sort" data-auto-submit>
						for _, sortOption := range page.SortOptions {
							<option value={ string(sortOption.Value) } selected?={ sortOption.Value == page.Sort }>{ sortOption.Label }</option>
						}
					</select>
				</label>
				@sortOrderToggle(page.Order, page.OrderToggleURL)
				<noscript>
					<button class="sort-form__apply" type="submit">Apply</button>
				</noscript>
			</form>
			if !page.Selecting {
				<a class="list-controls__select" href={ page.SelectToggleURL }>Select</a>
			}
		</div>
		if len(page.Games) > 0 {
			if page.Selecting {
				<form class="library-edit" method="post" action={ page.EditURL } data-selection>
					<ul class="game-grid">
						for _, entry := range page.Games {
							<li>
								@librarySelectCard(entry)
							</li>
						}
					</ul>
					<div class="library-edit__bar">
						@gameStatusPicker(page.EditStatuses, "")
						<div class="library-edit__actions">
							<button class="library-edit__apply" type="submit">Apply</button>
							<a class="library-edit__cancel" href={ page.SelectToggleURL }>Cancel</a>
						</div>
					</div>
				</form>
			} else {
				<ul class="game-grid">
					for _, entry := range page.Games {
						<li>
							@libraryCard(entry)
						</li>
					}
				</ul>
			}
		} else {
			<p>No results.</p>
		}
	}
}
