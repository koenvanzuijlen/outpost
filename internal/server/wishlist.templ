package server

// wishlistView renders the wishlist page: all wishlisted games.
templ wishlistView(page wishlistPage) {
	@layout("") {
		<h1>Wishlist</h1>
		<a href="/">Back to home</a>
		if len(page.Games) > 0 {
			<ul class="game-grid">
				for _, entry := range page.Games {
					<li>
						@gameCard(entry.Game, "", 0)
					</li>
				}
			</ul>
		} else {
			<p>Your wishlist is empty.</p>
		}
	}
}
