package server

import (
	"github.com/koenvanzuijlen/outpost/internal/database"
	"github.com/koenvanzuijlen/outpost/internal/database/dbgen"
	"strconv"
)

// gameCardContent is the inside of a game card: the cover, the title, the release year, and the status and the rating
// over the cover. A game without a cover shows a placeholder icon. A non-empty status shows as a compact badge and a
// rating above zero shows as stars.
templ gameCardContent(game dbgen.Game, status database.GameStatus, rating int64) {
	<span class="game-card__cover">
		if game.CoverUrl != nil {
			<img src={ *game.CoverUrl } alt="" width="264" height="374" loading="lazy"/>
		} else {
			@icon("image-off")
		}
	</span>
	<span class="game-card__title">{ game.Title }</span>
	if game.ReleasedAt != nil {
		<span class="game-card__year">{ game.ReleasedAt.Year() }</span>
	}
	if status != "" {
		<span class="game-card__status">
			@gameStatusBadge(status, true)
		</span>
	}
	if rating > 0 {
		<span class="game-card__rating">
			@ratingStars(rating, true)
		</span>
	}
}

// gameCard is a link to the game page with the content of gameCardContent. The status and the rating show over the
// cover on hover and keyboard focus, and are part of the link text.
templ gameCard(game dbgen.Game, status database.GameStatus, rating int64) {
	<a href={ gameURL(game.IgdbID) } class="game-card">
		@gameCardContent(game, status, rating)
	</a>
}

// libraryCard is the game card of a library entry, with its status and rating.
templ libraryCard(entry database.LibraryEntry) {
	@gameCard(
		entry.Game,
		database.GameStatus(derefOrZero(entry.UserGame.Status)),
		derefOrZero(entry.UserGame.Rating),
	)
}

// librarySelectCard is the card of a library entry in select mode: a label with a checkbox named igdb_id and the card
// content. It shows the status and no rating, and is not a link.
templ librarySelectCard(entry database.LibraryEntry) {
	<label class="game-card game-card--selectable">
		<input class="game-card__checkbox" type="checkbox" name="igdb_id" value={ strconv.FormatInt(entry.Game.IgdbID, 10) }/>
		@gameCardContent(entry.Game, database.GameStatus(derefOrZero(entry.UserGame.Status)), 0)
	</label>
}
