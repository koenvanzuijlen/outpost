package server

// settingsNavItems are the links in the submenu of the settings pages, in the order of the submenu.
var settingsNavItems = []tabNavItem{
	{Label: "Account", Href: "/settings/account"},
	{Label: "Preferences", Href: "/settings/preferences"},
	{Label: "Export", Href: "/settings/export"},
}

// settingsLayout is the page layout of the settings pages: the tab bar with settingsNavItems above the page content in
// children. The link whose Href is current is marked as the current page.
templ settingsLayout(current string) {
	@layout("") {
		<div class="account-page settings">
			@tabNav("Settings", settingsNavItems, current)
			{ children... }
		</div>
	}
}

// settingsSection is one section of the settings page with title as its heading. The children are the content of the
// section.
templ settingsSection(title string) {
	<section class="settings__section">
		<h2>{ title }</h2>
		{ children... }
	</section>
}
