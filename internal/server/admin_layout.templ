package server

// adminNavItem is one link in the submenu of the admin pages. Href is the path of the page.
type adminNavItem struct {
	Label string
	Href  string
}

// adminNavItems are the links in the submenu of the admin pages, in the order of the submenu.
var adminNavItems = []adminNavItem{
	{Label: "Users", Href: "/admin/users"},
	{Label: "Export", Href: "/admin/export"},
}

// adminLayout is the page layout of the admin pages: the submenu with adminNavItems above the page content in
// children. The link whose Href is current is marked as the current page.
templ adminLayout(current string) {
	@layout("") {
		<div class="admin">
			<nav class="admin-nav" aria-label="Admin">
				<ul class="admin-nav__list">
					for _, item := range adminNavItems {
						<li>
							<a
								class="admin-nav__link"
								href={ item.Href }
								if item.Href == current {
									aria-current="page"
								}
							>{ item.Label }</a>
						</li>
					}
				</ul>
			</nav>
			{ children... }
		</div>
	}
}
