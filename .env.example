# Timezone for the application, used to set playthrough start and end dates to "today" correctly.
TZ=Europe/Amsterdam

# Twitch API credentials, used for IGDB API access.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Set to true when Outpost is served over HTTPS. The browser then sends the session cookie only over HTTPS.
# Keep it false for plain HTTP, or sign-in does not work.
SECURE_COOKIES=false